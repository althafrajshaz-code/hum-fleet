<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:gravity="center_horizontal"
    android:padding="0dp">

    <!-- Top branding area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingBottom="20dp">

        <!-- App logo placeholder / car icon -->
        <TextView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:text="🚗"
            android:textSize="56sp"
            android:gravity="center"
            android:background="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming Ride Request"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp"/>

        <!-- Fare -->
        <TextView
            android:id="@+id/tv_call_fare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹---"
            android:textColor="#10B981"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <!-- Timer -->
        <TextView
            android:id="@+id/tv_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30s"
            android:textColor="#F59E0B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <!-- Divider -->
        <View
            android:layout_width="200dp"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="24dp"/>

        <!-- Pickup row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:text="●"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PICK UP"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tv_call_pickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Dropoff row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:text="■"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DROP OFF"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tv_call_dropoff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom action buttons - Accept / Decline like incoming call -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="40dp"
        android:layout_marginBottom="20dp">

        <!-- Decline (Red) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_call_decline"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/circle_red"
                android:src="@drawable/ic_call_end"
                android:scaleType="center"
                android:contentDescription="Decline Ride"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decline"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Accept (Green) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_call_accept"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/circle_green"
                android:src="@drawable/ic_call_accept"
                android:scaleType="center"
                android:contentDescription="Accept Ride"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accept"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
