{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "apks/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/apks/(.*)",
      "dest": "/apks/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
